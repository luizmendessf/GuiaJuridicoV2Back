SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Datasource (usar valores do ambiente de produção)
SPRING_DATASOURCE_URL=jdbc:mysql://db-host:3306/guia_juridico_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=change_me

# Hikari
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
SPRING_JPA_OPEN_IN_VIEW=false

# JWT
JWT_SECRET=REPLACE_WITH_BASE64_SECRET

# Google Sign-In (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Brevo — mesma API key da newsletter + remetente transacional verificado no painel
BREVO_SENDER_EMAIL=noreply@guiajuridico.org
BREVO_SENDER_NAME=Guia Jurídico

# URL do site (link no e-mail de redefinição de senha)
FRONTEND_URL=https://guiajuridico.org